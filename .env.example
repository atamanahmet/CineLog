# CineLog environment template.
# Copy to .env and replace every CHANGE_ME.
#
# Active line   = required, the stack stops without it.
# Commented line = optional, the code default applies when it is not set.
# Never write NAME= with an empty value, comment the line instead.
# Secrets: openssl rand -hex 32 (hex only, they are used inside URLs).

# ---------------------------------------------------------------------------
# 1. Database
# ---------------------------------------------------------------------------
# Backend database. In dev mode these also create the local Postgres container.
DB_NAME=cinelog
DB_USER=cinelog_user
DB_PASSWORD=CHANGE_ME

# Local Postgres container, dev mode only (ignored in neon mode).
# Host port, only for tools on your machine such as psql. Containers do not use it.
POSTGRES_HOST_PORT=5432
REC_DB_NAME=cinelog_rec
REC_ENGINE_DB_PASSWORD=CHANGE_ME
EMBEDDING_SCRIPT_DB_PASSWORD=CHANGE_ME

# DB_HOST and DB_PORT are not set here. The mode compose file sets them (dev),
# or you set them in .env.neon (neon).

# ---------------------------------------------------------------------------
# 2. Backend
# ---------------------------------------------------------------------------
# Host port of the backend.
SERVER_PORT=8080
# Shared with the embedding script.
TMDB_API_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME
# Browser origins allowed to call the API, comma separated, no trailing slash.
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
# Must stay false on plain http. Remove the line for a public https deployment.
AUTH_COOKIE_SECURE=false

# Optional: auth
# AUTH_ACCESS_TOKEN_TTL=
# AUTH_REFRESH_TOKEN_TTL=
# AUTH_COOKIE_SAME_SITE=

# Optional: features
# Leave CLOUDINARY_URL unset to disable profile photo upload.
# ADULT_CONTENT_ENABLED=
# CLOUDINARY_URL=
# CLOUDINARY_TIMEOUT_SECONDS=

# Optional: rec engine client and recommendation cache
# REC_CONNECT_TIMEOUT=
# REC_READ_TIMEOUT=
# REC_CACHE_TTL_HOURS=
# REC_CACHE_MAX_SIZE=
# REC_CACHE_HYDRATE_POOL_SIZE=
# REC_CACHE_HYDRATE_TIMEOUT_SECONDS=
# REC_QUALITY_MIN_VOTES_MOVIE=
# REC_QUALITY_MIN_VOTES_TV=

# Optional: other caches and scheduler
# DISCOVER_CACHE_ITEMS_PER_SORT=
# DISCOVER_CACHE_TTL_HOURS=
# DISCOVER_CACHE_REFRESH_HOURS=
# DETAILS_CACHE_TTL_HOURS=
# DETAILS_CACHE_MAX_SIZE=
# PERSON_CACHE_TTL_HOURS=
# PERSON_CACHE_MAX_SIZE=
# GENRE_CACHE_TTL_HOURS=
# SCHEDULING_POOL_SIZE=

# Optional: rate limits. Each limit is a token bucket:
# CAPACITY (burst), REFILL_TOKENS per REFILL_DURATION_SECONDS, MAX_WAIT_SECONDS (TMDB only).
# TMDB limits the calls to TMDB, WARM is the cache warmer, IP is per client, AUTH is login.
# RATELIMIT_TMDB_CAPACITY=
# RATELIMIT_TMDB_REFILL_TOKENS=
# RATELIMIT_TMDB_REFILL_DURATION_SECONDS=
# RATELIMIT_TMDB_MAX_WAIT_SECONDS=
# RATELIMIT_TMDB_RETRY_AFTER_DEFAULT_SECONDS=
# RATELIMIT_TMDB_WARM_CAPACITY=
# RATELIMIT_TMDB_WARM_REFILL_TOKENS=
# RATELIMIT_TMDB_WARM_REFILL_DURATION_SECONDS=
# RATELIMIT_TMDB_WARM_MAX_WAIT_SECONDS=
# RATELIMIT_IP_CAPACITY=
# RATELIMIT_IP_REFILL_TOKENS=
# RATELIMIT_IP_REFILL_DURATION_SECONDS=
# RATELIMIT_AUTH_CAPACITY=
# RATELIMIT_AUTH_REFILL_TOKENS=
# RATELIMIT_AUTH_REFILL_DURATION_SECONDS=

# ---------------------------------------------------------------------------
# 3. Frontend
# ---------------------------------------------------------------------------
# Baked into the image at build time, rebuild the frontend after a change.
VITE_API_URL=http://localhost/api

# ---------------------------------------------------------------------------
# 4. Rec engine
# ---------------------------------------------------------------------------
# Callers send UPDATE_TOKEN to /rec/update, the embedding script sends RELOAD_TOKEN.
UPDATE_TOKEN=CHANGE_ME
RELOAD_TOKEN=CHANGE_ME
# Max results per request. Feeds the backend and the engine, so both caps are equal.
REC_MAX_RESULTS=100

# Optional
# REC_MAX_EXCLUDE=
# SIMILARITY_THRESHOLD=
# DEFAULT_LIMIT=
# MAX_LOVED=
# UPDATE_RATE_LIMIT=
# RELOAD_RATE_LIMIT=
# DB_CONNECT_TIMEOUT_SECONDS=
# DB_CONNECT_RETRIES=
# MAX_CONTENT_LENGTH=
# GUNICORN_THREADS=
# GUNICORN_TIMEOUT=

# ---------------------------------------------------------------------------
# 5. Host scripts (embedding-script, run with make embed)
# ---------------------------------------------------------------------------
# Keep this section last, the URL uses variables defined above.
# Write access to the rec database. In neon mode set it in .env.neon.
REC_WRITE_DATABASE_URL=postgresql://app_embedding_script:${EMBEDDING_SCRIPT_DB_PASSWORD}@localhost:${POSTGRES_HOST_PORT}/${REC_DB_NAME}
# Rec engine as the host sees it, no path. Used for the reload request.
REC_ENGINE_URL=http://rec-engine:8181
REC_ENGINE_BASE_URL=http://localhost:8181

# Optional
# RELOAD_HTTP_TIMEOUT_S=
