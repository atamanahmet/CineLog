# CineLog neon overrides.
# Copy to .env.neon. It is loaded after .env in neon mode, so list only what differs.
# Commands: make start neon, make embed neon. Rules: docs/ENVIRONMENT.md

# Neon database for the backend.
DB_HOST=CHANGE_ME
DB_PORT=5432
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Rec database, read access for the rec engine. Use a hex password.
REC_DATABASE_URL=postgresql://app_rec_engine:CHANGE_ME@CHANGE_ME_HOST/CHANGE_ME_REC_DB?sslmode=require

# Rec database, write access for the embedding script.
REC_WRITE_DATABASE_URL=postgresql://app_embedding_script:CHANGE_ME@CHANGE_ME_HOST/CHANGE_ME_REC_DB?sslmode=require

# Values from .env that usually change for a public deployment.
# AUTH_ALLOWED_ORIGINS=
# AUTH_COOKIE_SECURE=
# VITE_API_URL=
# REC_ENGINE_BASE_URL=
# CLOUDINARY_URL=
